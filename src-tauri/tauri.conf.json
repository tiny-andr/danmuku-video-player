{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Danmuku Video Player",
  "version": "1.3.1",
  "identifier": "com.danmuku.video.player",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Danmuku Video Player · 本地视频 + 弹幕播放器",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: http://asset.localhost",
        "media-src": "'self' blob: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost blob:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "resources/ffmpeg.exe": "ffmpeg.exe"
    },
    "fileAssociations": [
      {
        "ext": ["mp4", "m4v", "webm", "mov", "mkv", "avi", "ts", "flv", "wmv", "mpg", "mpeg"],
        "name": "Video",
        "description": "视频文件",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}